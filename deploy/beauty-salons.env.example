# Server environment: lives at /etc/beauty-salons.env (chmod 600), never in git.
PLACES_API_KEY=

# Max Google Places calls per day (photo downloads + photo-name refreshes).
# Keep it below the quota set in Google Cloud (currently 50/day).
PLACES_DAILY_BUDGET=30

# Public hostname of this VM, e.g. a free duckdns.org subdomain pointing at its IP.
API_DOMAIN=

# Frontends allowed to call the API (comma-separated, no trailing slash).
ALLOWED_ORIGINS=https://warsaw-salon-explorer-eta.vercel.app,http://localhost:3000

DB_PATH=/var/lib/beauty-salons/salons.db
PHOTO_CACHE_DIR=/var/lib/beauty-salons/photo_cache
ENV=production
