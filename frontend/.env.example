# Copy to .env.local for local development; on Vercel set these in Project Settings → Environment Variables.

# Backend the /api/* proxy forwards to (server-side only, read at build time).
# Local: http://localhost:3001 (default). Vercel: https://<your-backend-domain>
API_PROXY_TARGET=http://localhost:3001

# Google Maps JavaScript API key for the map view (restrict it to your domains in Google Cloud).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
